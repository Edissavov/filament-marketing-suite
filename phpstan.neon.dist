includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 4
    paths:
        - src
        - config
        - database
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
    ignoreErrors:
        # False positive: this is a package config file. It is published into the
        # host app's config directory, where env() calls are valid as usual.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/marketing-suite.php

